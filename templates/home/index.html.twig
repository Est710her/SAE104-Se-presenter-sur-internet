    <div class="comp-card" onclick="togglePanel('c3')">
      <div class="comp-num">03</div>
      <span class="comp-pill">Compétence 3</span>
      <h3 class="comp-title">Créer des outils et applications R&T</h3>
      <p class="comp-desc">Développer des scripts, outils et applications répondant aux besoins des réseaux.</p>
      <hr class="comp-sep"/>
