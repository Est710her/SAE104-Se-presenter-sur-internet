<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Portfolio – Nkene Nzame Djust Esther</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:#12102b; --bg2:#1a1740; --bg3:#221e52;
      --violet:#6c5ce7; --violet2:#a29bfe; --violet3:#4834d4;
      --rose:#fd79a8; --cyan:#74b9ff;
      --text:#f0eeff; --muted:#9b97c5; --border:rgba(108,92,231,0.18);
      --card:rgba(26,23,64,0.85);
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--bg);color:var(--text);font-family:"Plus Jakarta Sans",sans-serif;font-weight:400;line-height:1.7;overflow-x:hidden;}
    body::before,body::after{content:"";position:fixed;border-radius:50%;pointer-events:none;z-index:0;}
    body::before{width:600px;height:600px;background:radial-gradient(circle,rgba(108,92,231,0.15) 0%,transparent 70%);top:-100px;left:-100px;}
    body::after{width:500px;height:500px;background:radial-gradient(circle,rgba(253,121,168,0.08) 0%,transparent 70%);bottom:0;right:-100px;}
    nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:1rem 3rem;background:rgba(18,16,43,0.9);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);}
    .nav-brand{font-family:"Playfair Display",serif;font-size:1.1rem;color:var(--violet2);}
    .nav-links{display:flex;gap:2rem;list-style:none;}
    .nav-links a{color:var(--muted);text-decoration:none;font-size:0.8rem;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;transition:color 0.2s;}
    .nav-links a:hover{color:var(--violet2);}
    .hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:4rem;padding:8rem 4rem 4rem;position:relative;z-index:1;}
    .hero-left{display:flex;flex-direction:column;gap:1.5rem;}
    .hero-badge{display:inline-flex;align-items:center;gap:0.5rem;background:rgba(108,92,231,0.15);border:1px solid rgba(108,92,231,0.3);padding:0.4rem 1rem;border-radius:999px;font-size:0.72rem;font-weight:500;color:var(--violet2);width:fit-content;letter-spacing:0.08em;text-transform:uppercase;}
    .hero-badge::before{content:"●";font-size:0.5rem;color:var(--rose);}
    .hero h1{font-family:"Playfair Display",serif;font-size:clamp(2.2rem,5vw,3.8rem);line-height:1.15;font-weight:700;}
    .hero h1 span{color:var(--violet2);display:block;}
    .hero-desc{color:var(--muted);font-size:0.95rem;max-width:420px;}
    .hero-btns{display:flex;gap:1rem;flex-wrap:wrap;margin-top:0.5rem;}
    .btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.7rem 1.5rem;border-radius:8px;font-size:0.82rem;font-weight:600;text-decoration:none;transition:all 0.22s;cursor:pointer;border:none;font-family:inherit;}
    .btn-violet{background:var(--violet);color:#fff;}
    .btn-violet:hover{background:var(--violet3);transform:translateY(-2px);box-shadow:0 8px 24px rgba(108,92,231,0.4);}
    .btn-outline{background:transparent;color:var(--violet2);border:1px solid rgba(108,92,231,0.4);}
    .btn-outline:hover{background:rgba(108,92,231,0.1);transform:translateY(-2px);}
    .hero-right{display:flex;flex-direction:column;align-items:center;gap:2rem;}
    .hero-photo-wrap{position:relative;width:220px;height:220px;}
    .hero-photo-ring{position:absolute;inset:-8px;border-radius:50%;background:conic-gradient(var(--violet),var(--rose),var(--cyan),var(--violet));animation:spinRing 6s linear infinite;}
    .hero-photo-ring-mask{position:absolute;inset:3px;border-radius:50%;background:var(--bg);}
    @keyframes spinRing{to{transform:rotate(360deg);}}
    .hero-photo{position:relative;z-index:2;width:100%;height:100%;object-fit:cover;border-radius:50%;border:4px solid var(--bg);}
    .hero-info-cards{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;width:100%;}
    .info-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.2rem;backdrop-filter:blur(8px);}
    .info-card-label{font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);margin-bottom:0.25rem;}
    .info-card-value{font-size:0.85rem;font-weight:600;color:var(--text);}
    .section{padding:6rem 4rem;position:relative;z-index:1;max-width:1200px;margin:0 auto;}
    .section-tag{display:inline-flex;align-items:center;gap:0.6rem;font-size:0.65rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:var(--violet2);margin-bottom:0.8rem;}
    .section-tag::before{content:"";width:1.5rem;height:1px;background:currentColor;}
    h2{font-family:"Playfair Display",serif;font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:700;margin-bottom:0.5rem;line-height:1.2;}
    .section-sub{color:var(--muted);font-size:0.88rem;max-width:520px;margin-bottom:2.5rem;}
    .hr{border:none;border-top:1px solid var(--border);margin:0;}
    .hobbies-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;}
    .hobby-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:2rem 1rem;text-align:center;backdrop-filter:blur(8px);transition:transform 0.22s,border-color 0.22s,box-shadow 0.22s;}
    .hobby-card:hover{transform:translateY(-6px);border-color:rgba(108,92,231,0.4);box-shadow:0 16px 40px rgba(108,92,231,0.15);}
    .hobby-emoji{font-size:2.5rem;margin-bottom:0.8rem;display:block;}
    .hobby-name{font-weight:600;font-size:0.9rem;}
    .comp-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.2rem;}
    .comp-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:2rem;backdrop-filter:blur(8px);cursor:pointer;transition:transform 0.22s,box-shadow 0.22s,border-color 0.22s;position:relative;overflow:hidden;}
    .comp-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;border-radius:16px 16px 0 0;}
    .comp-card:nth-child(1)::before{background:linear-gradient(90deg,var(--violet),var(--violet2));}
    .comp-card:nth-child(2)::before{background:linear-gradient(90deg,var(--rose),#fd4a8a);}
    .comp-card:nth-child(3)::before{background:linear-gradient(90deg,var(--cyan),#0984e3);}
    .comp-card:hover{transform:translateY(-5px);}
    .comp-card:nth-child(1):hover{border-color:rgba(108,92,231,0.4);box-shadow:0 16px 40px rgba(108,92,231,0.15);}
    .comp-card:nth-child(2):hover{border-color:rgba(253,121,168,0.4);box-shadow:0 16px 40px rgba(253,121,168,0.12);}
    .comp-card:nth-child(3):hover{border-color:rgba(116,185,255,0.4);box-shadow:0 16px 40px rgba(116,185,255,0.12);}
    .comp-num{position:absolute;right:1.2rem;top:0.8rem;font-family:"Playfair Display",serif;font-size:4rem;font-weight:700;opacity:0.05;line-height:1;}
    .comp-pill{display:inline-block;font-size:0.62rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;padding:0.25rem 0.8rem;border-radius:999px;margin-bottom:1rem;}
    .comp-card:nth-child(1) .comp-pill{background:rgba(108,92,231,0.15);color:var(--violet2);}
    .comp-card:nth-child(2) .comp-pill{background:rgba(253,121,168,0.15);color:var(--rose);}
    .comp-card:nth-child(3) .comp-pill{background:rgba(116,185,255,0.15);color:var(--cyan);}
    .comp-title{font-family:"Playfair Display",serif;font-size:1.1rem;font-weight:700;margin-bottom:0.6rem;}
    .comp-desc{font-size:0.82rem;color:var(--muted);line-height:1.65;margin-bottom:1.2rem;}
    .comp-sep{border:none;border-top:1px solid var(--border);margin-bottom:1rem;}
    .comp-ac-label{font-size:0.6rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);margin-bottom:0.5rem;}
    .comp-ac-list{list-style:none;display:flex;flex-direction:column;gap:0.3rem;}
    .comp-ac-list li{font-size:0.78rem;display:flex;gap:0.5rem;align-items:flex-start;}
    .comp-ac-list li::before{content:"→";opacity:0.4;flex-shrink:0;}
    .comp-open-btn{display:inline-flex;align-items:center;gap:0.3rem;margin-top:1rem;font-size:0.75rem;font-weight:600;border:none;background:none;cursor:pointer;transition:gap 0.2s;font-family:inherit;}
    .comp-card:nth-child(1) .comp-open-btn{color:var(--violet2);}
    .comp-card:nth-child(2) .comp-open-btn{color:var(--rose);}
    .comp-card:nth-child(3) .comp-open-btn{color:var(--cyan);}
    .comp-open-btn:hover{gap:0.7rem;}
    .detail-panel{display:none;border-top:1px solid var(--border);position:relative;z-index:1;}
    .detail-panel.open{display:block;}
    .detail-inner{max-width:1100px;margin:0 auto;padding:3rem 4rem;}
    .detail-top{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;margin-bottom:2.5rem;}
    .close-btn{background:rgba(108,92,231,0.1);border:1px solid rgba(108,92,231,0.3);color:var(--violet2);padding:0.5rem 1.2rem;border-radius:8px;cursor:pointer;font-family:inherit;font-size:0.75rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;transition:all 0.2s;}
    .close-btn:hover{background:rgba(108,92,231,0.2);}
    .jordao-block{background:rgba(26,23,64,0.6);border:1px solid var(--border);border-radius:14px;padding:2rem 2.2rem;margin-bottom:1.5rem;backdrop-filter:blur(8px);}
    .jordao-block-title{display:flex;align-items:center;gap:0.6rem;font-family:"Playfair Display",serif;font-size:1.05rem;font-weight:700;margin-bottom:1.2rem;}
    .jordao-block-title::before{content:"►";font-size:0.8rem;}
    .jordao-item{margin-bottom:0.9rem;font-size:0.85rem;line-height:1.7;}
    .jordao-item strong{color:var(--text);}
    .jordao-item span{color:var(--muted);}
    .captures-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem;margin-bottom:1rem;}
    .capture-box{background:rgba(18,16,43,0.8);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
    .capture-box img{width:100%;display:block;border-bottom:1px solid var(--border);}
    .capture-placeholder{width:100%;height:160px;background:linear-gradient(135deg,rgba(108,92,231,0.08),rgba(253,121,168,0.04));display:flex;align-items:center;justify-content:center;flex-direction:column;gap:0.5rem;border-bottom:1px solid var(--border);}
    .capture-placeholder span{font-size:2rem;}
    .capture-placeholder p{font-size:0.7rem;color:var(--muted);}
    .capture-label{padding:0.7rem 1rem;font-size:0.75rem;font-weight:600;color:var(--muted);}
    .gibbs-title-block{display:flex;align-items:center;gap:0.6rem;font-family:"Playfair Display",serif;font-size:1.05rem;font-weight:700;margin-bottom:1.2rem;}
    .gibbs-title-block::before{content:"►";font-size:0.8rem;}
    .gibbs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;}
    .gibbs-box{background:rgba(18,16,43,0.7);border:1px solid var(--border);border-radius:12px;padding:1.4rem;position:relative;}
    .gibbs-n{position:absolute;right:1rem;top:0.5rem;font-family:"Playfair Display",serif;font-size:3.5rem;font-weight:700;opacity:0.05;line-height:1;}
    .gibbs-step{font-size:0.6rem;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:0.3rem;}
    .gibbs-step-title{font-family:"Playfair Display",serif;font-size:0.95rem;font-weight:700;margin-bottom:0.6rem;}
    .gibbs-body{font-size:0.82rem;color:var(--muted);line-height:1.7;}
    .contact-wrap{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:3rem;backdrop-filter:blur(8px);max-width:620px;margin:0 auto;}
    .form-group{margin-bottom:1.2rem;}
    .form-label{display:block;font-size:0.78rem;font-weight:500;margin-bottom:0.4rem;color:var(--muted);}
    .form-input,.form-textarea{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:10px;padding:0.75rem 1rem;color:var(--text);font-family:inherit;font-size:0.85rem;transition:border-color 0.2s;}
    .form-input:focus,.form-textarea:focus{outline:none;border-color:rgba(108,92,231,0.5);box-shadow:0 0 0 3px rgba(108,92,231,0.1);}
    .form-textarea{resize:vertical;min-height:120px;}
    .form-submit{width:100%;padding:0.85rem;background:var(--violet);color:#fff;border:none;border-radius:10px;font-family:inherit;font-size:0.85rem;font-weight:600;cursor:pointer;transition:all 0.22s;}
    .form-submit:hover{background:var(--violet3);transform:translateY(-2px);box-shadow:0 8px 24px rgba(108,92,231,0.4);}
    footer{border-top:1px solid var(--border);padding:2rem 4rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;position:relative;z-index:1;}
    footer p{font-size:0.75rem;color:var(--muted);}
    .footer-heart{color:var(--rose);}
    @media(max-width:900px){
      nav{padding:1rem 1.5rem;}.nav-links{gap:1rem;font-size:0.7rem;}
      .hero{grid-template-columns:1fr;padding:6rem 1.5rem 3rem;gap:2.5rem;text-align:center;}
      .hero-left{align-items:center;}.hero-desc{text-align:center;}
      .hero-right{order:-1;}
      .section{padding:4rem 1.5rem;}
      .detail-inner{padding:2rem 1.5rem;}
      footer{padding:1.5rem;}
    }
  </style>
</head>
