</div>

<!-- PANEL C2 -->
<div class="detail-panel" id="panel-c2">
  <div class="detail-inner">
    <div class="detail-top">
      <div><div class="section-tag" style="color:var(--rose)">Compétence 2</div><h2>Connecter les entreprises et les usagers</h2></div>
      <button class="close-btn" onclick="togglePanel('c2')">✕ Fermer</button>
    </div>
