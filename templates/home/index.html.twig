      <div class="gibbs-box"><div class="gibbs-n">4</div><div class="gibbs-step">Étape 4</div><div class="gibbs-title">Analyse</div><div class="gibbs-body"><em>[À remplir]</em></div></div>
      <div class="gibbs-box"><div class="gibbs-n">5</div><div class="gibbs-step">Étape 5</div><div class="gibbs-title">Conclusion</div><div class="gibbs-body"><em>[À remplir]</em></div></div>
      <div class="gibbs-box"><div class="gibbs-n">6</div><div class="gibbs-step">Étape 6</div><div class="gibbs-title">Plan d'action</div><div class="gibbs-body"><em>[À remplir]</em></div></div>
    </div>
